        { "id": "asphalt", "label": "Architectural asphalt shingles installed", "unit": "sq ft", "when": { "field": "roof_material", "value": "asphalt" }, "qtyField": "roof_size", "qtyMap": { "small": 1700, "medium": 2600, "large": 3700, "xl": 4800 }, "rate": 4.25 },
