  "packages": [
    {
      "id": "essential", "label": "Essential", "factor": 1.0,
      "tagline": "Code-compliant, manufacturer-warrantied, done right.",
      "includes": ["Licensed & insured crew", "Manufacturer warranty", "Permit + clean-up"]
    },
    {
      "id": "preferred", "label": "Preferred", "factor": 1.12, "recommended": true,
      "tagline": "Most popular: upgraded materials and priority scheduling.",
      "includes": ["Everything in Essential", "Upgraded materials", "Priority scheduling", "10-yr workmanship warranty"]
    },
    {
      "id": "elite", "label": "Elite", "factor": 1.28,
      "tagline": "Top-tier materials, white-glove service, lifetime peace of mind.",
