  "terms": [
    "25% deposit reserves your install date; balance due on completion.",
    "Quote valid for 14 days. Material price changes after that may apply.",
    "Permits, disposal and clean-up are included where listed.",
    "Cancel within 3 business days of signing for a full deposit refund."
