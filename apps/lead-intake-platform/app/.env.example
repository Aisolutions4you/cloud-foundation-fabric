# ---- Business -------------------------------------------------------------
BUSINESS_NAME="Summit Field Services"
PUBLIC_BASE_URL=http://localhost:8080
# GHL calendar / Calendly link for "book a call" outcomes
BOOKING_URL=
# Stripe Payment Link used for the onboarding deposit step
STRIPE_PAYMENT_LINK=
# protects /#/admin and /api/admin/*
ADMIN_TOKEN=change-me

# ---- LLMs (all OpenAI-compatible; tried in this order, first success wins) --
LLM_PROVIDER_ORDER=openrouter,local,openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Portable / self-hosted: Ollama (:11434/v1), LM Studio (:1234/v1), vLLM, llama.cpp
# e.g. http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# ---- GoHighLevel (LeadConnector API v2, Private Integration token) ---------
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_NEW=
GHL_STAGE_QUALIFIED=
GHL_STAGE_QUOTED=
GHL_STAGE_WON=

# ---- Automation fan-out (twin.so agents, n8n, Make, Zapier) ----------------
# webhook trigger URL of your twin.so agent
TWIN_WEBHOOK_URL=
# comma-separated extra targets (n8n, Make, Zapier)
OUTBOUND_WEBHOOK_URLS=
# HMAC secret receivers use to verify X-Signature
WEBHOOK_SIGNING_SECRET=
# secret automations use to sign calls back into /api/webhooks/inbound
INBOUND_WEBHOOK_SECRET=
